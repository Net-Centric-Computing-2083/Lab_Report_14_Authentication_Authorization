@model IEnumerable<System.Security.Claims.Claim>

@{
    ViewData["Title"] = "User Claims";
}

<div class="container mt-4">

    <h1>User Claims</h1>

    <table class="table table-bordered">

        <thead>

            <tr>
                <th>Claim Type</th>
                <th>Claim Value</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var claim in Model)
            {
                <tr>

                    <td>
                        @claim.Type
                    </td>

                    <td>
                        @claim.Value
                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>