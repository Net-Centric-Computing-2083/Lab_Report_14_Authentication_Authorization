@{
    ViewData["Title"] = "Profile";
}

<div class="container mt-4">

    <h1>User Profile</h1>


    <table class="table table-bordered">

        <tr>

            <th>
                Email / Username
            </th>

            <td>
                @ViewBag.Email
            </td>

        </tr>


        <tr>

            <th>
                Role
            </th>

            <td>
                @ViewBag.Role
            </td>

        </tr>


        <tr>

            <th>
                Department
            </th>

            <td>
                @ViewBag.Department
            </td>

        </tr>

    </table>

</div>